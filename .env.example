# Fine-grained personal access token of the GitHub account that owns the world repositories:
# Contents: Read and write (push the backups) and Administration: Read and write (create a missing repository),
# on all repositories of the account (or on the world repositories you created yourself, with Contents only).
GITHUB_TOKEN=github_pat_REPLACE_ME

# The Foundry user data folder: the one with Config, Data and Logs (Data/worlds holds the worlds).
FOUNDRY_DATA=/home/foundry/foundrydata

# Where the schedule and per-world settings live (see config.example.json). The admin page rewrites it.
CONFIG_FILE=./config.json

# Where the service keeps its git copies (repos/<world id>) and status.json. Default: state next to CONFIG_FILE.
# STATE_DIR=./state

# The file holding GITHUB_TOKEN: a token changed on the admin page is written to its GITHUB_TOKEN line.
# Defaults to env next to CONFIG_FILE.
# ENV_FILE=./env

# Where Foundry answers, for /api/status (is a world active?). Empty = never ask.
FOUNDRY_URL=http://localhost:30000

# The git command (default: git from PATH).
# GIT_BIN=/usr/bin/git

# Daily check of the token; problems are e-mailed to the recipients in admin.json.
# DAILY_CHECK=off

# Administration page and notification e-mails: settings in admin.json, created by the installers.
# Defaults to admin.json next to CONFIG_FILE. The page is off until that file holds a password hash
# (node src/admin.js setup admin.json with FOUNDRY_BACKUP_ADMIN_PASSWORD set, or the installer's --set-admin-password).
# ADMIN_FILE=./admin.json

# The admin page: its own port, HTTPS with a self-signed certificate (admin-tls.crt/.key next to CONFIG_FILE, made by
# the installer; a temporary one if missing).
ADMIN_PORT=8484
ADMIN_HOST=0.0.0.0
# ADMIN_TLS=off                     plain HTTP: only behind a reverse proxy that does HTTPS
# ADMIN_TLS_CERT=/path/fullchain.pem
# ADMIN_TLS_KEY=/path/privkey.pem
# Extra host names the admin page answers to (besides localhost, this machine's names and addresses, ADMIN_HOST and
# ADMIN_PUBLIC_URL's host).
# ADMIN_HOSTS=backup.example.lan
# ADMIN_PUBLIC_URL=https://backup.example.com
# ADMIN_TRUST_PROXY=1               trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy on this machine
#                                   (or the proxies' IP addresses, comma separated; others' headers are ignored)
